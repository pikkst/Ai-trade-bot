# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:5173
APP_LOG_LEVEL=INFO
APP_PRETTY_LOGS=true
APP_CORRELATION_HEADER=X-Correlation-ID
APP_VERSION=0.1.0

# Supabase and PostgreSQL
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/ai_trade_bot
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_SECONDS=30

# External cloud scheduling
SCHEDULER_MODE=external
RESEARCH_ENVIRONMENT=development
RESEARCH_CYCLE_INTERVAL=1h
RESEARCH_CYCLE_LOCK_KEY=ai-trade-bot-development
RESEARCH_CYCLE_TIMEOUT_SECONDS=900
REDIS_ENABLED=false
ARQ_ENABLED=false
WEBSOCKET_INGESTION_ENABLED=false

# Authentication and API
JWT_SECRET=replace-with-a-long-random-secret-for-local-development-only
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
PASSWORD_MIN_LENGTH=12
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Binance public REST market data
BINANCE_MARKET_DATA_ENABLED=true
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_REQUEST_TIMEOUT_SECONDS=15
BINANCE_MAX_RETRIES=5
BINANCE_METADATA_REFRESH_MINUTES=60
BINANCE_MAX_CLOCK_DRIFT_SECONDS=5
MARKET_SYMBOLS=BTC/EUR
MARKET_INTERVALS=1h
MARKET_DATA_STALE_AFTER_SECONDS=7200

# AI provider
AI_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.1
GEMINI_DAILY_REQUEST_BUDGET=24
GEMINI_DAILY_TOKEN_BUDGET=100000
GEMINI_MONTHLY_COST_BUDGET_EUR=0
GEMINI_PROMPT_VERSION=1.0.0
GEMINI_REPORT_SCHEMA_VERSION=1.0
GEMINI_SAFETY_CONFIG_VERSION=1.0.0
GEMINI_LOG_PROMPTS=false
GEMINI_STORE_RAW_RESPONSE=true
GEMINI_RAW_RESPONSE_RETENTION_DAYS=180

# Feature engineering
FEATURE_SET_VERSION=1.0.0
FEATURE_MINIMUM_HISTORY_CANDLES=250

# Strategy
STRATEGY_NAME=hold-only
STRATEGY_VERSION=1.0.0
STRATEGY_GEMINI_POLICY=optional

# Paper trading
PAPER_INITIAL_CASH_EUR=20
PAPER_EXECUTION_MODEL_VERSION=1.0.0
PAPER_FEE_BPS=10
PAPER_SPREAD_BPS=5
PAPER_SLIPPAGE_BPS=5
PAPER_MAX_OPEN_ORDERS=1

# Risk
RISK_POLICY_VERSION=1.0.0
RISK_MAX_POSITION_PERCENT=25
RISK_MAX_GROSS_EXPOSURE_PERCENT=25
RISK_MAX_ORDER_NOTIONAL_EUR=5
RISK_MAX_DAILY_DRAWDOWN_PERCENT=5
RISK_MAX_TOTAL_DRAWDOWN_PERCENT=15
RISK_MAX_CONSECUTIVE_LOSSES=3
RISK_COOLDOWN_MINUTES=120
RISK_ALLOW_SHORTING=false
RISK_ALLOW_LEVERAGE=false

# Experiment
EXPERIMENT_DURATION_DAYS=30
EXPERIMENT_PRIMARY_SYMBOL=BTC/EUR
EXPERIMENT_HUMAN_REVIEW_ENABLED=true

# Free-tier observability
HOSTED_PROMETHEUS_ENABLED=false
HOSTED_GRAFANA_ENABLED=false
OTEL_ENABLED=false
OPERATIONAL_LOG_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
AI_RAW_RESPONSE_RETENTION_DAYS=180

# Safety feature flags
LIVE_TRADING_ENABLED=false
PRIVATE_BINANCE_API_ENABLED=false
WITHDRAWALS_ENABLED=false
LEVERAGE_ENABLED=false
SHORTING_ENABLED=false
