# The Daily Roast AI — Safe Environment Variable Inventory
# Last reviewed: 2026-08-01
# This file contains names and safe defaults/placeholders only.
# Never place real credentials in this file.
#
# Environment variables configure deployment wiring and bootstrap defaults.
# Immutable workspace/experiment behavior is stored in versioned database
# configuration and behavior sets. Changing an environment default must never
# mutate a running experiment.

# -----------------------------------------------------------------------------
# Application identity and runtime
# M001 / M005
# -----------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:5173
APP_VERSION=0.0.0-dev
APP_COMMIT_SHA=local
APP_LOG_LEVEL=INFO
APP_PRETTY_LOGS=true
APP_CORRELATION_HEADER=X-Correlation-ID
APP_TIMEZONE=UTC

# -----------------------------------------------------------------------------
# Frontend-public allowlist
# These are the only classes of values allowed in the browser build.
# Never add service-role, database, Gemini, signing, or exchange secrets.
# M004 / M015 / M028
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_ENV=development
VITE_APP_VERSION=0.0.0-dev

# -----------------------------------------------------------------------------
# Supabase PostgreSQL and Auth — server/local tooling only
# M003
# Supabase Auth is authoritative. The active profile has no unrelated custom
# password database or application JWT-signing secret.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_SECONDS=30
DATABASE_SSL_MODE=prefer
DATABASE_EXPECTED_MIGRATION_HEAD=

# -----------------------------------------------------------------------------
# Application authorization and session policy
# Identity comes from Supabase Auth; roles/permissions are server-side and RLS
# protected. Exact production session/recovery/MFA design is versioned later.
# M003 / M014 / M023
# -----------------------------------------------------------------------------
AUTH_REQUIRED=true
AUTH_RECENT_AUTH_MAX_AGE_SECONDS=900
AUTH_CLOCK_SKEW_SECONDS=30
AUTH_ALLOW_ANONYMOUS_PUBLIC_DEMO=false

# -----------------------------------------------------------------------------
# External scheduling and one-shot research cycle
# M012 / M028 / M029
# GitHub Actions is best effort. Render is not the scheduler.
# -----------------------------------------------------------------------------
SCHEDULER_MODE=external
RESEARCH_ENVIRONMENT=development
RESEARCH_CYCLE_INTERVAL=1h
RESEARCH_CYCLE_LOCK_NAMESPACE=thedailyroast-development
RESEARCH_CYCLE_LOCK_TIMEOUT_SECONDS=30
RESEARCH_CYCLE_LEASE_SECONDS=1200
RESEARCH_CYCLE_TIMEOUT_SECONDS=900
RESEARCH_CYCLE_MAX_RETRIES=0

# -----------------------------------------------------------------------------
# CORS, HTTP, and client boundaries
# M005 / M014 / M028
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
TRUSTED_HOSTS=localhost,127.0.0.1
API_DEFAULT_PAGE_SIZE=50
API_MAX_PAGE_SIZE=200
API_REQUEST_TIMEOUT_SECONDS=30
API_ENABLE_DOCS=true

# -----------------------------------------------------------------------------
# Binance public REST market data
# M006 / M007
# No private key or secret variable exists in the active profile.
# -----------------------------------------------------------------------------
BINANCE_MARKET_DATA_ENABLED=true
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_REQUEST_TIMEOUT_SECONDS=15
BINANCE_MAX_RETRIES=5
BINANCE_METADATA_REFRESH_MINUTES=60
BINANCE_MAX_CLOCK_DRIFT_SECONDS=5
MARKET_SYMBOLS=BTC/EUR
MARKET_INTERVALS=1h
MARKET_DATA_STALE_AFTER_SECONDS=7200
MARKET_BACKFILL_MAX_DAYS=365
MARKET_BACKFILL_PAGE_LIMIT=1000

# -----------------------------------------------------------------------------
# Gemini advisory provider transport and bootstrap budget
# M006 / M009
# Normal local/CI use AI_PROVIDER=fake and GEMINI_ENABLED=false.
# Immutable experiment provider/model/prompt/schema/safety/validation/budget
# versions are stored in PostgreSQL.
# -----------------------------------------------------------------------------
AI_PROVIDER=fake
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.1
GEMINI_DAILY_REQUEST_BUDGET=24
GEMINI_DAILY_TOKEN_BUDGET=100000
GEMINI_MONTHLY_COST_BUDGET_EUR=0
GEMINI_PROMPT_VERSION=1.0.0
GEMINI_REPORT_SCHEMA_VERSION=1.0
GEMINI_SAFETY_CONFIG_VERSION=1.0.0
GEMINI_VALIDATION_POLICY_VERSION=1.0.0
GEMINI_LOG_PROMPTS=false
GEMINI_STORE_RAW_RESPONSE=false
GEMINI_RAW_RESPONSE_RETENTION_DAYS=180
ALLOW_PAID_PROVIDER_USAGE=false
ALLOW_AUTOMATIC_PROVIDER_UPGRADE=false

# -----------------------------------------------------------------------------
# Bootstrap domain defaults for local seed/configuration creation
# M008–M011
# These values seed a new versioned configuration. They are not read as mutable
# authority by a running experiment.
# -----------------------------------------------------------------------------
DEFAULT_FEATURE_SET_VERSION=1.0.0
DEFAULT_FEATURE_MINIMUM_HISTORY_CANDLES=250
DEFAULT_STRATEGY_NAME=hold-only
DEFAULT_STRATEGY_VERSION=1.0.0
DEFAULT_STRATEGY_GEMINI_POLICY=optional
DEFAULT_RISK_POLICY_VERSION=1.0.0
DEFAULT_EXECUTION_MODEL_VERSION=1.0.0
DEFAULT_ACCOUNTING_POLICY_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Local/formal experiment bootstrap defaults
# M011 / M022 / M029
# Actual experiment values are frozen in immutable configuration before start.
# -----------------------------------------------------------------------------
DEFAULT_PAPER_INITIAL_CASH_EUR=20
DEFAULT_PAPER_FEE_BPS=10
DEFAULT_PAPER_SPREAD_BPS=5
DEFAULT_PAPER_SLIPPAGE_BPS=5
DEFAULT_PAPER_MAX_OPEN_ORDERS=1
DEFAULT_RISK_MAX_POSITION_PERCENT=25
DEFAULT_RISK_MAX_GROSS_EXPOSURE_PERCENT=25
DEFAULT_RISK_MAX_ORDER_NOTIONAL_EUR=5
DEFAULT_RISK_MAX_DAILY_DRAWDOWN_PERCENT=5
DEFAULT_RISK_MAX_TOTAL_DRAWDOWN_PERCENT=15
DEFAULT_RISK_MAX_CONSECUTIVE_LOSSES=3
DEFAULT_RISK_COOLDOWN_MINUTES=120
DEFAULT_EXPERIMENT_DURATION_DAYS=30
DEFAULT_EXPERIMENT_PRIMARY_SYMBOL=BTC/EUR
DEFAULT_EXPERIMENT_HUMAN_REVIEW_ENABLED=true

# -----------------------------------------------------------------------------
# Export, retention, and recovery bootstrap
# M027 / M029 / M031
# Retention policies become versioned database records before production use.
# -----------------------------------------------------------------------------
EXPORT_STORAGE_MODE=local
EXPORT_LOCAL_DIRECTORY=.local/exports
EXPORT_ENCRYPTION_REQUIRED=false
OPERATIONAL_LOG_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
AI_RAW_RESPONSE_RETENTION_DAYS=180
FAILED_JOB_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Free-profile observability adapters
# M005 / M012 / M022 / M029 / M030
# Structured logs and persistent database evidence are mandatory.
# Hosted metrics/tracing remain disabled unless M034 activates them.
# -----------------------------------------------------------------------------
STRUCTURED_LOGGING_ENABLED=true
PERSIST_CYCLE_STAGE_EVIDENCE=true
PERSIST_AUDIT_EVENTS=true
PERSIST_INCIDENT_EVENTS=true
HOSTED_PROMETHEUS_ENABLED=false
HOSTED_GRAFANA_ENABLED=false
OTEL_ENABLED=false

# -----------------------------------------------------------------------------
# Explicitly prohibited/deferred feature flags
# Startup must reject unsafe combinations in every M001–M036 environment.
# A true value in M001–M036 is a configuration error, not an activation path.
# -----------------------------------------------------------------------------
REDIS_ENABLED=false
ARQ_ENABLED=false
PERSISTENT_WORKER_ENABLED=false
WEBSOCKET_INGESTION_ENABLED=false
AUTOMATIC_SCALING_ENABLED=false
AUTOMATIC_PLAN_UPGRADE_ENABLED=false
LIVE_TRADING_ENABLED=false
BINANCE_TEST_TRADING_ENABLED=false
PRIVATE_BINANCE_API_ENABLED=false
EXCHANGE_ORDER_EXECUTION_ENABLED=false
WITHDRAWALS_ENABLED=false
CUSTODY_ENABLED=false
LEVERAGE_ENABLED=false
MARGIN_ENABLED=false
FUTURES_ENABLED=false
OPTIONS_ENABLED=false
SHORTING_ENABLED=false
AI_TOOL_CALLING_ENABLED=false
AI_DATABASE_MUTATION_ENABLED=false
AI_ORDER_EXECUTION_ENABLED=false
AUTOMATIC_STRATEGY_PROMOTION_ENABLED=false
AUTOMATIC_RELEASE_APPROVAL_ENABLED=false
AUTOMATIC_BEHAVIOR_ACTIVATION_ENABLED=false
